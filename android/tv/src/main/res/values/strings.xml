<?xml version="1.0" encoding="utf-8"?>
<!--
  All of grandpa's on-screen text lives here, in one short list, so it can be
  translated by replacing this file (values-ml/strings.xml for Malayalam,
  values-hi/ for Hindi) without touching any code.

  The screen is deliberately mostly pictures and colour: a large caller name, a
  green or red state, and very few words.
-->
