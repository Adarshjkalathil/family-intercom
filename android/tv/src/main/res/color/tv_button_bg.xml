<?xml version="1.0" encoding="utf-8"?>
<!-- The focused button turns green, so the remote's position is always obvious. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:color="@color/surface_card" />
    <item android:state_focused="true" android:color="@color/brand" />
    <item android:state_pressed="true" android:color="@color/brand" />
    <item android:color="@color/surface_card" />
</selector>
