<?xml version="1.0" encoding="utf-8"?>
<!-- WhatsApp-style call screen: dark, a large avatar and name, round buttons. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/call_bg"
    android:keepScreenOn="true">

    <!--
      Everyone else in the call: the whole screen for one, a grid with names for
      a group. Pictures are shown whole; tapping switches to filling the screen.
    -->
    <com.kalathil.intercom.core.VideoGrid
        android:id="@+id/remoteGrid"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <org.webrtc.SurfaceViewRenderer
        android:id="@+id/localVideo"
        android:layout_width="120dp"
        android:layout_height="160dp"
        android:layout_gravity="top|end"
        android:layout_margin="20dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/statusPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="72dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/call_encrypted"
            android:textColor="@color/call_text_dim"
            android:textSize="13sp" />

        <FrameLayout
            android:layout_width="128dp"
            android:layout_height="128dp"
            android:layout_marginTop="48dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_avatar" />

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_tv"
                app:tint="@color/white" />
        </FrameLayout>

        <TextView
            android:id="@+id/headline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:paddingHorizontal="24dp"
            android:textColor="@color/white"
            android:textSize="26sp" />

        <TextView
            android:id="@+id/subhead"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/call_text_dim"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Ringing: decline and answer. -->
    <LinearLayout
        android:id="@+id/controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="72dp"
        android:gravity="center"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="40dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/decline"
                style="@style/Intercom.CallButton"
                android:contentDescription="@string/decline"
                app:backgroundTint="@color/danger"
                app:icon="@drawable/ic_call_end" />

            <TextView
                style="@style/Intercom.CallLabel"
                android:text="@string/decline" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="40dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/answer"
                style="@style/Intercom.CallButton"
                android:contentDescription="@string/answer"
                app:backgroundTint="@color/brand_light"
                app:icon="@drawable/ic_videocam" />

            <TextView
                style="@style/Intercom.CallLabel"
                android:text="@string/answer" />
        </LinearLayout>
    </LinearLayout>

    <!-- In a call: mute, flip, end - on a rounded bar like WhatsApp's. -->
    <LinearLayout
        android:id="@+id/inCallControls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="40dp"
        android:background="@drawable/bg_call_bar"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingVertical="14dp"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/switchCamera"
            style="@style/Intercom.CallButton"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginHorizontal="12dp"
            android:contentDescription="@string/switch_camera"
            app:icon="@drawable/ic_switch_camera"
            app:iconSize="28dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/mute"
            style="@style/Intercom.CallButton"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginHorizontal="12dp"
            android:contentDescription="@string/mute"
            app:icon="@drawable/ic_mic"
            app:iconSize="28dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/hangUp"
            style="@style/Intercom.CallButton"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginHorizontal="12dp"
            android:contentDescription="@string/hang_up"
            app:backgroundTint="@color/danger"
            app:icon="@drawable/ic_call_end"
            app:iconSize="28dp" />
    </LinearLayout>
</FrameLayout>
