<?xml version="1.0" encoding="utf-8"?>
<!-- WhatsApp's palette. Light theme here; values-night/colors.xml overrides the
     colours that change in dark mode. -->
<resources>
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>

    <!-- Brand greens -->
    <color name="brand">#FF00A884</color>
    <color name="brand_dark">#FF008069</color>
    <color name="brand_light">#FF25D366</color>
    <color name="danger">#FFF15C6D</color>

    <!-- Theme-dependent (overridden in values-night) -->
    <color name="app_bg">#FFFFFFFF</color>
    <color name="app_surface">#FFF0F2F5</color>
    <color name="toolbar_bg">#FF008069</color>
    <color name="on_toolbar">#FFFFFFFF</color>
    <color name="text_primary">#FF111B21</color>
    <color name="text_secondary">#FF667781</color>
    <color name="divider">#FFE9EDEF</color>
    <color name="warning_bg">#FFFFF3C4</color>
    <color name="warning_text">#FF6B5200</color>

    <!-- The call screen is always dark, as on WhatsApp -->
    <color name="call_bg">#FF0B141A</color>
    <color name="call_surface">#FF1F2C34</color>
    <color name="call_button">#FF3B4A54</color>
    <color name="call_text_dim">#FF8696A0</color>
</resources>
